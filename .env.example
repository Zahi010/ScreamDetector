# Festival Scream Detector - Environment Configuration Template
# Copy this file to .env and adjust paths as needed.

# Dataset Directories (default local paths)
OPENSLR99_DIR=C:\Users\zahia\Downloads\NonverbalVocalization\NonverbalVocalization
NIGENS_DIR=C:\Users\zahia\Downloads\NIGENS\NIGENS

# Backend API Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DATABASE_URL=sqlite:///./scream_detector.db

# Audio & Detection Settings
SAMPLE_RATE=16000
FRAME_LENGTH_SECONDS=0.975
FRAME_STEP_SECONDS=0.5
SCREAM_THRESHOLD=0.65
ALERT_COOLDOWN_SECONDS=3.0

# Pretrained YAMNet Model
TFHUB_MODEL_HANDLE=https://tfhub.dev/google/yamnet/1
LOCAL_MODEL_DIR=./models
